      "title": "Audit graph",
      "items": [
        "Fan-out per obligation, max 4 parallel",
        "retrieve, assess, verify_citations",
        "Unverified citations: needs_review",
        "Digest mode: summaries only, no code audit"
      ]
    },
    {
      "dot": "amber",
      "title": "Guardrails",
      "items": [
        "Unchanged rules: run skipped, no cost",
        "Cost cap per run: $2 by default",
        "No API keys: offline analyst",
        "Inbox: only alert recipients can queue a run"
      ]
