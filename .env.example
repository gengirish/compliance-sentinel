# Copy to .env. Everything is optional for a local dry run: with nothing set the app uses
# an embedded database, a local embedder, the offline keyword analyst, and logs alerts
# instead of sending them.

# --- Storage -------------------------------------------------------------------
# Neon Postgres (pgvector is enabled by the first migration). Use the direct connection
# string, not the "-pooler" one, with sslmode=verify-full:
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full
# Unset: embedded PGlite under .data/pglite.
DATABASE_URL=
# Redis for BullMQ (web + worker only). docker compose: redis://localhost:6379
REDIS_URL=

# --- Models --------------------------------------------------------------------
# Unset: the offline keyword baseline runs instead of Claude.
ANTHROPIC_API_KEY=
# Unset: a local hash embedder runs instead of voyage-law-2.
VOYAGE_API_KEY=
# Hard cap on model spend per run, in USD.
MAX_RUN_COST_USD=2
# Obligations assessed in parallel.
AUDIT_CONCURRENCY=4
# A run still "running" after this many minutes is marked failed (worker crashed mid-run).
RUN_TIMEOUT_MINUTES=30

# --- Alerts (sent only when a critical violation is found) -----------------------
SLACK_WEBHOOK_URL=
# AgentMail (https://agentmail.to): the app's own inbox. Alerts go out from it with the PDF
# attached, and mail sent to it reaches the web process through a signed webhook, so an
# alert recipient can reply "run audit" to queue a run. Unset: email is logged, not sent.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Printed by `pnpm agentmail:webhook <public url>`, which registers the webhook.
AGENTMAIL_WEBHOOK_SECRET=
# Comma-separated recipients; also the only senders whose "run audit" emails are acted on.
ALERT_EMAIL_TO=

# --- Report storage (Fly Tigris, S3-compatible). Unset: ./reports ----------------
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev

# --- Audit target ----------------------------------------------------------------
# A local path, or a git URL that is shallow-cloned at run time. Default: demo-target-app.
TARGET_REPO_PATH=
TARGET_REPO_URL=

# --- Sources ---------------------------------------------------------------------
# The SCRAPE_* flags are defaults. The dashboard's Settings page switches each source on or
# off without a restart, and its choice wins until you press Reset there.
SCRAPE_FEDERAL_REGISTER=true
FEDREG_TERM="data security privacy safeguards"
FEDREG_AGENCIES=federal-trade-commission
FEDREG_PER_PAGE=5
EURLEX_CELEX=32016R0679
# Set to false to skip the Playwright source (for example where Chromium is not installed).
SCRAPE_EURLEX=true
# SEC final rules (Federal Register API, filtered to the SEC).
SEC_TERM="cybersecurity customer information safeguards"
SEC_PER_PAGE=5
SCRAPE_SEC=true
# FCA publications RSS; comma-separated publication types to keep (plural and case do not matter).
FCA_TYPES="Policy statements,Consultation papers,Finalised guidance,Multi-firm reviews"
FCA_MAX_ITEMS=10
SCRAPE_FCA=true
# MAS circulars need Chromium and pdftotext (poppler-utils; in the Docker image). Off by default.
MAS_MAX_ITEMS=5
PDFTOTEXT_BIN=pdftotext
SCRAPE_MAS=false
# ESMA news (site-wide RSS). ESMA_TOPICS narrows to the site's sections, e.g. "Market Abuse,MiFID - Secondary Markets".
ESMA_TOPICS=
ESMA_MAX_ITEMS=10
SCRAPE_ESMA=true
# FINRA notices RSS; kinds by title prefix (Regulatory Notice, Information Notice, Election Notice...).
FINRA_TYPES="Regulatory Notice"
FINRA_MAX_ITEMS=10
SCRAPE_FINRA=true
# ASIC regulatory tracker (new and reissued regulatory guides, information sheets, reports). PDFs via pdftotext.
ASIC_MAX_ITEMS=10
ASIC_INCLUDE_PDF=true
SCRAPE_ASIC=true

# --- Scheduling and HTTP -----------------------------------------------------------
AUDIT_CRON="0 6 * * *"
# Weekly digest of every rule change (email + Slack), whether or not it was audited. UTC.
DIGEST_CRON="0 7 * * 1"
DIGEST_DAYS=7
# Bearer token for POST /runs, GET /runs and GET /reports/:id. Unset: those routes return 503.
RUN_TRIGGER_TOKEN=
PORT=8080

# --- GitHub App (docs/plan-app-pr-review.md, Phase A) -------------------------------
# Installs create tenants and queue baseline audits through POST /github/webhook.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Unset: the webhook route returns 503. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The App's .pem, inline (newlines as \n, which is how a Fly secret holds it) or as a path. Inline wins.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
