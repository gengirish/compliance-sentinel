# Compliance Sentinel API (the Hono server in the repo root). Server-side only.
SENTINEL_API_URL=http://localhost:8080
# Must equal RUN_TRIGGER_TOKEN in the root .env.
SENTINEL_API_TOKEN=

# Clerk. Leave both unset in local dev to use Clerk's keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
